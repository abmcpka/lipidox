function escapeXml(s) {
  return String(s).replace(/[<>&'"]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;',"'":'&apos;','"':'&quot;'}[c]));
}

// Tooltip lines look like "Lipid: DG 36:2<br>Group: ...". Parse them into
// fields so the download keeps every value the network can show.
function titleFields(title) {
  const out = {};
  String(title || '').split(/<br\s*\/?>/i).forEach(line => {
    const i = line.indexOf(':');
    if (i <= 0) return;
    const key = line.slice(0, i).trim();
    if (key) out[key] = line.slice(i + 1).trim();
  });
  return out;
}

function csvCell(v) {
  if (v === null || v === undefined) return '';
  v = String(v);
  return /[",\r\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v;
}

function csvRow(vals) {
  return vals.map(csvCell).join(',') + '\r\n';
}

function buildDownloadCsv() {
  const lines = [];
  const meta = Object.assign({}, EXTRA.meta || {}, {
    title: (document.getElementById('figTitle') || {}).textContent || '',
    network_type: NETWORK_TYPE,
    node_count: NODES.length,
    edge_count: EDGES.length,
  });
  if (CURRENT_MODE) meta.lipid_mode = CURRENT_MODE;

  lines.push('# Metadata\r\n', csvRow(['key', 'value']));
  Object.keys(meta).forEach(k => lines.push(csvRow([k, meta[k]])));
  lines.push('\r\n');

  const section = (name, items, baseCols, idKey) => {
    const keys = [];
    items.forEach(it => Object.keys(titleFields(it.title)).forEach(k => {
      if (!keys.includes(k)) keys.push(k);
    }));
    lines.push(`# ${name} (${items.length})\r\n`);
    lines.push(csvRow(baseCols.concat(keys)));
    items.forEach(it => {
      const f = titleFields(it.title);
      lines.push(csvRow(baseCols.map(c => it[c]).concat(keys.map(k => f[k]))));
    });
    lines.push('\r\n');
  };

  section('Nodes', NODES, ['id', 'label', 'shape', 'color', 'size']);
  section('Edges', EDGES, ['id', 'from', 'to', 'label', 'color', 'width', 'arrows']);

  if (EXTRA.rows && EXTRA.rows.length) {
    const label = NETWORK_TYPE === 'pathway' ? 'Reaction chains' : 'Reactions';
    lines.push(`# ${label} (${EXTRA.rows.length})\r\n`);
    lines.push(csvRow(EXTRA.columns));
    EXTRA.rows.forEach(r => lines.push(csvRow(EXTRA.columns.map(c => r[c]))));
  }
  return lines.join('');
}

function downloadTable() {
  const csv = buildDownloadCsv();
  const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `${NETWORK_TYPE}${CURRENT_MODE ? '_' + CURRENT_MODE : ''}_table_${new Date().toISOString().slice(0,10)}.csv`;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

// ----- Export: replay the displayed canvas as real vector geometry -----
// vis-network only paints to a canvas, so grabbing it would rasterise the figure
// (blurry labels) and take the zoom buttons with it. Instead we record the draw
// calls vis makes for the current view - positions, node sizes, line widths,
// arrow scale, colours, fonts, hidden nodes, zoom and pan - and replay them as
// SVG. The legend overlay is rebuilt in SVG from the live DOM.
const figureExport = (function () {
  const RECORDED = ['save', 'restore', 'beginPath', 'closePath', 'moveTo', 'lineTo',
    'quadraticCurveTo', 'bezierCurveTo', 'arc', 'arcTo', 'rect', 'ellipse', 'fill',
    'stroke', 'fillText', 'strokeText', 'translate', 'rotate', 'scale', 'transform',
    'setTransform', 'resetTransform', 'setLineDash', 'fillRect', 'strokeRect',
    'clearRect', 'clip'];

  function snapshot(ctx) {
    return {
      fill: ctx.fillStyle, stroke: ctx.strokeStyle, lw: ctx.lineWidth,
      font: ctx.font, ta: ctx.textAlign, tb: ctx.textBaseline,
      alpha: ctx.globalAlpha, cap: ctx.lineCap, join: ctx.lineJoin
    };
  }

  function record(draw) {
    const proto = CanvasRenderingContext2D.prototype;
    const ops = [];
    const orig = {};
    RECORDED.forEach(function (name) {
      orig[name] = proto[name];
      proto[name] = function () {
        ops.push({ op: name, a: Array.prototype.slice.call(arguments), s: snapshot(this) });
        return orig[name].apply(this, arguments);
      };
    });
    try { draw(); } finally { RECORDED.forEach(function (n) { proto[n] = orig[n]; }); }
    return ops;
  }

  function mul(m, t) {
    return [m[0] * t[0] + m[2] * t[1], m[1] * t[0] + m[3] * t[1],
            m[0] * t[2] + m[2] * t[3], m[1] * t[2] + m[3] * t[3],
            m[0] * t[4] + m[2] * t[5] + m[4], m[1] * t[4] + m[3] * t[5] + m[5]];
  }

  function esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function r3(v) { return Math.round(v * 1000) / 1000; }

  function fontBits(font) {
    const size = (/([0-9.]+)px/.exec(font) || [0, 12])[1];
    const family = (/([0-9.]+)px\s+(.+)$/.exec(font) || [0, '', 'sans-serif'])[2];
    return {
      size: parseFloat(size),
      family: family.replace(/["']/g, '').trim() || 'sans-serif',
      bold: /bold/i.test(font),
      italic: /italic/i.test(font)
    };
  }

  // SVG 1.1 has no rgba(): split it into a solid colour plus opacity.
  function color(c) {
    const m = /^rgba?\(\s*([0-9.]+)[,\s]+([0-9.]+)[,\s]+([0-9.]+)(?:[,\s/]+([0-9.]+))?\s*\)$/.exec(String(c));
    if (!m) { return { c: String(c), a: 1 }; }
    return { c: 'rgb(' + m[1] + ',' + m[2] + ',' + m[3] + ')',
             a: m[4] === undefined ? 1 : parseFloat(m[4]) };
  }

  let mctx = null;
  function metrics(font, text) {
    if (!mctx) { mctx = document.createElement('canvas').getContext('2d'); }
    mctx.font = font;
    const mm = mctx.measureText(text);
    let asc = mm.fontBoundingBoxAscent, desc = mm.fontBoundingBoxDescent;
    if (asc == null || desc == null) {
      asc = (parseFloat(font) || 12) * 0.8; desc = (parseFloat(font) || 12) * 0.2;
    }
    return { asc: asc, desc: desc };
  }

  function render(ops) {
    let m = [1, 0, 0, 1, 0, 0];
    const stack = [];
    const out = [];
    let d = '';
    let dash = [];
    let moved = true;

    function T() { return ' transform="matrix(' + m.map(r3).join(',') + ')"'; }
    function pt(x, y) { return r3(x) + ' ' + r3(y); }
    function fillOpacity(c, s) {
      const a = c.a * (s.alpha == null ? 1 : s.alpha);
      return a < 1 ? ' fill-opacity="' + r3(a) + '"' : '';
    }
    function strokeOpacity(c, s) {
      const a = c.a * (s.alpha == null ? 1 : s.alpha);
      return a < 1 ? ' stroke-opacity="' + r3(a) + '"' : '';
    }

    function arcSeg(x, y, rx, ry, rot, a0, a1, ccw) {
      const full = Math.abs(a1 - a0) >= 2 * Math.PI - 1e-9;
      const sx = x + rx * Math.cos(a0), sy = y + ry * Math.sin(a0);
      if (moved || !d) { d += 'M ' + pt(sx, sy); moved = false; } else { d += ' L ' + pt(sx, sy); }
      const deg = r3(rot * 180 / Math.PI);
      if (full) {
        const mx = x + rx * Math.cos(a0 + Math.PI), my = y + ry * Math.sin(a0 + Math.PI);
        d += ' A ' + r3(rx) + ' ' + r3(ry) + ' ' + deg + ' 1 1 ' + pt(mx, my);
        d += ' A ' + r3(rx) + ' ' + r3(ry) + ' ' + deg + ' 1 1 ' + pt(sx, sy);
      } else {
        let sweep = a1 - a0;
        if (ccw) { if (sweep > 0) { sweep -= 2 * Math.PI; } } else if (sweep < 0) { sweep += 2 * Math.PI; }
        const ex = x + rx * Math.cos(a1), ey = y + ry * Math.sin(a1);
        d += ' A ' + r3(rx) + ' ' + r3(ry) + ' ' + deg + ' '
          + (Math.abs(sweep) > Math.PI ? 1 : 0) + ' ' + (sweep > 0 ? 1 : 0) + ' ' + pt(ex, ey);
      }
    }

    ops.forEach(function (o) {
      const a = o.a, s = o.s;
      switch (o.op) {
        case 'save': stack.push(m.slice()); break;
        case 'restore': if (stack.length) { m = stack.pop(); } break;
        case 'translate': m = mul(m, [1, 0, 0, 1, a[0], a[1]]); break;
        case 'scale': m = mul(m, [a[0], 0, 0, a[1], 0, 0]); break;
        case 'rotate': m = mul(m, [Math.cos(a[0]), Math.sin(a[0]), -Math.sin(a[0]), Math.cos(a[0]), 0, 0]); break;
        case 'transform': m = mul(m, a); break;
        case 'setTransform': m = a.length === 6 ? a.slice() : [1, 0, 0, 1, 0, 0]; break;
        case 'resetTransform': m = [1, 0, 0, 1, 0, 0]; break;
        case 'beginPath': d = ''; moved = true; break;
        case 'closePath': if (d) { d += ' Z'; moved = true; } break;
        case 'moveTo': d += ' M ' + pt(a[0], a[1]); moved = false; break;
        case 'lineTo': d += ' L ' + pt(a[0], a[1]); break;
        case 'quadraticCurveTo': d += ' Q ' + pt(a[0], a[1]) + ' ' + pt(a[2], a[3]); break;
        case 'bezierCurveTo': d += ' C ' + pt(a[0], a[1]) + ' ' + pt(a[2], a[3]) + ' ' + pt(a[4], a[5]); break;
        case 'arc': arcSeg(a[0], a[1], a[2], a[2], 0, a[3], a[4], a[5]); break;
        case 'arcTo': d += ' L ' + pt(a[0], a[1]); break;
        case 'ellipse': arcSeg(a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7]); break;
        case 'rect':
          d += ' M ' + pt(a[0], a[1]) + ' H ' + r3(a[0] + a[2]) + ' V ' + r3(a[1] + a[3])
            + ' H ' + r3(a[0]) + ' Z'; moved = true; break;
        case 'setLineDash': dash = a[0] || []; break;
        case 'fill': {
          if (!d) { break; }
          const fc = color(s.fill);
          out.push('<path d="' + d + '" fill="' + esc(fc.c) + '"' + fillOpacity(fc, s) + T() + '/>');
          break;
        }
        case 'stroke': {
          if (!d) { break; }
          const sc = color(s.stroke);
          out.push('<path d="' + d + '" fill="none" stroke="' + esc(sc.c)
            + '" stroke-width="' + r3(s.lw) + '"'
            + (dash.length ? ' stroke-dasharray="' + dash.join(' ') + '"' : '')
            + (s.cap !== 'butt' ? ' stroke-linecap="' + s.cap + '"' : '')
            + (s.join !== 'miter' ? ' stroke-linejoin="' + s.join + '"' : '')
            + strokeOpacity(sc, s) + T() + '/>');
          break;
        }
        case 'fillText': case 'strokeText': {
          const f = fontBits(s.font);
          const anchor = s.ta === 'center' ? 'middle' : (s.ta === 'right' || s.ta === 'end') ? 'end' : 'start';
          const mm = metrics(s.font, a[0]);
          const dy = { middle: (mm.asc - mm.desc) / 2, top: mm.asc, hanging: mm.asc,
                       bottom: -mm.desc, ideographic: -mm.desc }[s.tb] || 0;
          const tc = color(o.op === 'fillText' ? s.fill : s.stroke);
          let body = '<text x="' + r3(a[1]) + '" y="' + r3(a[2] + dy) + '" font-family="' + esc(f.family)
            + '" font-size="' + r3(f.size) + '"' + (f.bold ? ' font-weight="bold"' : '')
            + (f.italic ? ' font-style="italic"' : '')
            + ' text-anchor="' + anchor + '"';
          if (o.op === 'fillText') {
            body += ' fill="' + esc(tc.c) + '"' + fillOpacity(tc, s) + T() + '>' + esc(a[0]) + '</text>';
          } else {
            body += ' fill="none" stroke="' + esc(tc.c) + '" stroke-width="' + r3(s.lw)
              + '" stroke-linejoin="round"' + strokeOpacity(tc, s) + T() + '>' + esc(a[0]) + '</text>';
          }
          out.push(body);
          break;
        }
        case 'fillRect': {
          const fr = color(s.fill);
          out.push('<rect x="' + r3(a[0]) + '" y="' + r3(a[1]) + '" width="' + r3(a[2])
            + '" height="' + r3(a[3]) + '" fill="' + esc(fr.c) + '"' + fillOpacity(fr, s) + T() + '/>');
          break;
        }
        case 'strokeRect': {
          const sr = color(s.stroke);
          out.push('<rect x="' + r3(a[0]) + '" y="' + r3(a[1]) + '" width="' + r3(a[2])
            + '" height="' + r3(a[3]) + '" fill="none" stroke="' + esc(sr.c)
            + '" stroke-width="' + r3(s.lw) + '"' + strokeOpacity(sr, s) + T() + '/>');
          break;
        }
        default: break;   // clearRect, clip: the viewBox does the cropping
      }
    });
    return out.join('');
  }

  // ---- legend: the HTML overlay, redrawn as SVG -------------------------
  function parseGradient(str) {
    const stops = [];
    const re = /rgba?\([^)]*\)|#[0-9a-fA-F]{3,8}/g;
    let mm;
    while ((mm = re.exec(str))) { stops.push(mm[0]); }
    return stops;
  }

  function legendSvg(base) {
    const box = document.getElementById('legend');
    if (!box) { return ''; }
    const r = box.getBoundingClientRect();
    const x = r.left - base.left, y = r.top - base.top;
    const out = [];
    out.push('<rect x="' + r3(x) + '" y="' + r3(y) + '" width="' + r3(r.width) + '" height="'
      + r3(r.height) + '" rx="4" fill="rgba(255,255,255,0.95)" stroke="#999" stroke-width="1"/>');

    const els = box.querySelectorAll('*');
    Array.prototype.forEach.call(els, function (el) {
      const cs = getComputedStyle(el);
      const b = el.getBoundingClientRect();
      const w = b.width, h = b.height;
      if (w <= 0 || h <= 0) { return; }
      const left = b.left - base.left, top = b.top - base.top;

      const bgImg = cs.backgroundImage || '';
      if (bgImg.indexOf('gradient') >= 0) {
        const cols = parseGradient(bgImg);
        if (cols.length) {
          const gid = 'lg' + out.length;
          out.push('<defs><linearGradient id="' + gid + '" x1="0" x2="1">'
            + cols.map(function (c, i) {
                return '<stop offset="' + r3(i / Math.max(1, cols.length - 1))
                  + '" stop-color="' + esc(c) + '"/>';
              }).join('') + '</linearGradient></defs>');
          out.push('<rect x="' + r3(left) + '" y="' + r3(top) + '" width="' + r3(w) + '" height="' + r3(h)
            + '" fill="url(#' + gid + ')" stroke="#333" stroke-width="1"/>');
        }
      } else if (cs.backgroundColor && cs.backgroundColor !== 'rgba(0, 0, 0, 0)') {
        out.push('<rect x="' + r3(left) + '" y="' + r3(top) + '" width="' + r3(w) + '" height="' + r3(h)
          + '" rx="' + r3(parseFloat(cs.borderTopLeftRadius) || 0) + '" fill="' + esc(cs.backgroundColor)
          + '" stroke="#333" stroke-width="1"/>');
      }

      const btw = parseFloat(cs.borderTopWidth) || 0;
      if (btw > 0 && cs.borderTopStyle === 'solid' && h <= btw + 2 && w > h) {
        out.push('<line x1="' + r3(left) + '" y1="' + r3(top + h / 2) + '" x2="' + r3(left + w)
          + '" y2="' + r3(top + h / 2) + '" stroke="' + esc(cs.borderTopColor)
          + '" stroke-width="' + r3(btw) + '"/>');
      }

      const blw = parseFloat(cs.borderLeftWidth) || 0;
      if (blw > 0 && cs.borderLeftStyle === 'solid' && w <= blw + 2 && h > w
          && (parseFloat(cs.borderTopWidth) || 0) > 0) {
        out.push('<polygon points="' + r3(left + w) + ',' + r3(top + h / 2) + ' '
          + r3(left) + ',' + r3(top) + ' ' + r3(left) + ',' + r3(top + h)
          + '" fill="' + esc(cs.borderLeftColor) + '"/>');
      }

      Array.prototype.forEach.call(el.childNodes, function (node) {
        if (node.nodeType !== 3 || !node.textContent.trim()) { return; }
        const range = document.createRange();
        range.selectNodeContents(node);
        const tr = range.getClientRects()[0];
        if (!tr) { return; }
        const fs = parseFloat(cs.fontSize) || 11;
        const bold = cs.fontWeight === 'bold' || parseInt(cs.fontWeight, 10) >= 600;
        const mm = metrics((bold ? 'bold ' : '') + fs + 'px ' + cs.fontFamily, node.textContent);
        out.push('<text x="' + r3(tr.left - base.left) + '" y="'
          + r3(tr.top - base.top + (tr.height - (mm.asc + mm.desc)) / 2 + mm.asc)
          + '" font-family="' + esc(cs.fontFamily) + '" font-size="' + r3(fs) + '"'
          + (bold ? ' font-weight="bold"' : '') + ' fill="' + esc(cs.color) + '">'
          + esc(node.textContent.replace(/\s+/g, ' ').trim()) + '</text>');
      });
    });
    return out.join('');
  }

  // ---- assemble the SVG for the current view ----------------------------
  function svg() {
    const canvas = document.querySelector('#mynetwork canvas');
    if (!canvas) { throw new Error('network canvas not found'); }
    const W = canvas.clientWidth || canvas.width;
    const H = canvas.clientHeight || canvas.height;
    const pr = canvas.width / W;   // retina backing store, if any

    const ops = record(function () { network.redraw(); });
    if (!ops.length) { throw new Error('vis-network drew nothing - nothing to export'); }

    const base = document.getElementById('networkWrapper').getBoundingClientRect();
    const body = render(ops);
    const legend = legendSvg(base);

    return '<svg xmlns="http://www.w3.org/2000/svg" width="' + W + '" height="' + H
      + '" viewBox="0 0 ' + W + ' ' + H + '">'
      + '<rect width="' + W + '" height="' + H + '" fill="#ffffff"/>'
      + '<g transform="scale(' + r3(1 / pr) + ')">' + body + '</g>'
      + legend
      + '<rect x="0.5" y="0.5" width="' + r3(W - 1) + '" height="' + r3(H - 1)
      + '" fill="none" stroke="#ccc" stroke-width="1"/>'
      + '</svg>';
  }

  function raster(svgText, scale) {
    return new Promise(function (resolve, reject) {
      const box = /<svg[^>]*width="([0-9.]+)"[^>]*height="([0-9.]+)"/.exec(svgText) || [0, 1200, 700];
      const img = new Image();
      img.onload = function () {
        const c = document.createElement('canvas');
        c.width = Math.max(1, Math.round(parseFloat(box[1]) * scale));
        c.height = Math.max(1, Math.round(parseFloat(box[2]) * scale));
        const g = c.getContext('2d');
        g.fillStyle = '#ffffff';
        g.fillRect(0, 0, c.width, c.height);
        g.drawImage(img, 0, 0, c.width, c.height);
        resolve(c);
      };
      img.onerror = function () { reject(new Error('could not rasterise the SVG')); };
      img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgText);
    });
  }

  return { svg: svg, raster: raster };
})();

function syncExportUI() {
  const active = document.querySelector('#fmtSeg .seg-btn.active');
  const fmt = (active && active.dataset.fmt) || 'svg';
  const row = document.getElementById('pngScaleRow');
  if (row) row.style.display = fmt === 'png' ? '' : 'none';
  const lbl = document.getElementById('dpiScaleVal');
  if (lbl) lbl.textContent = String(exportScale());
}

function exportScale() {
  const el = document.getElementById('dpiScale');
  return Math.min(10, Math.max(1, parseInt(el && el.value, 10) || 1));
}

function captureFigure(scale) {
  const svg = figureExport.svg();
  return figureExport.raster(svg, scale);
}

function saveBlob(blob, name) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = name;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
}

function figureName(ext) {
  const mode = CURRENT_MODE ? '_' + CURRENT_MODE : '';
  return NETWORK_TYPE + mode + '_' + new Date().toISOString().slice(0, 10) + '.' + ext;
}

function previewExport() {
  const active = document.querySelector('#fmtSeg .seg-btn.active');
  const fmt = (active && active.dataset.fmt) || 'svg';
  const scale = fmt === 'png' ? exportScale() : 2;
  captureFigure(Math.min(2, scale)).then(function (canvas) {
    document.getElementById('previewNote').textContent = fmt === 'png'
      ? 'PNG - exactly what the page shows, rasterised at ' + scale + '\u00d7.'
      : 'SVG - exactly what the page shows, as editable vector geometry.';
    document.getElementById('previewImg').src = canvas.toDataURL('image/png');
    document.getElementById('previewModal').style.display = 'block';
  }).catch(function (err) {
    alert('Preview failed: ' + err.message);
  });
}

function closePreview() { document.getElementById('previewModal').style.display = 'none'; }

function downloadFigure() {
  const active = document.querySelector('#fmtSeg .seg-btn.active');
  const fmt = (active && active.dataset.fmt) || 'svg';
  try {
    if (fmt === 'svg') {
      saveBlob(new Blob([figureExport.svg()], { type: 'image/svg+xml' }), figureName('svg'));
      return;
    }
    captureFigure(exportScale()).then(function (canvas) {
      canvas.toBlob(function (blob) { saveBlob(blob, figureName('png')); }, 'image/png');
    }).catch(function (err) {
      alert('Export failed: ' + err.message);
    });
  } catch (err) {
    alert('Export failed: ' + err.message);
  }
}

syncExportUI();

function legendSwatch(shape, color, label) {
  const s = shape === 'square' ? 'border-radius:0' : (shape === 'circle' ? 'border-radius:50%' : 'border-radius:0');
  return `<div style="display:flex;align-items:center;gap:6px;margin:2px 0;"><span style="display:inline-block;width:14px;height:14px;background:${color};border:1px solid #333;${s};flex-shrink:0;"></span> <span>${label}</span></div>`;
}
// Node color ramp used by GATOM (LipidSigR .gatomNodeColor: #4169E1 -> #CCEEFF / #FFE4E1 -> #FF4500).
const LOG2FC_RAMP = ['#4169E1', '#CCEEFF', '#CCCCCC', '#FFE4E1', '#FF4500'];
// Edge colors produced by LipidSigR, in display order. Colors absent from EDGES are hidden
// so the legend never advertises a color the viewer does not render.
const EDGE_LEGEND = {
  pathway: [
    ['#FF4500', 'Activated (z > 1.645)'],
    ['#FFD2D2', 'Weakly activated (0 < z \u2264 1.645)'],
    ['#DDDDFF', 'Weakly suppressed (\u22121.645 \u2264 z < 0)'],
    ['#4169E1', 'Suppressed (z < \u22121.645)'],
    ['#666666', 'No change (z = 0)'],
  ],
  gatom: [
    ['#FF4500', 'Up in DE (log2FC > 0)'],
    ['#4169E1', 'Down in DE (log2FC < 0)'],
    ['#DDDDDD', 'No DE gene mapped'],
  ],
  lipid_reaction: [
    ['#FF8800', 'Biochemical reaction (enzyme)'],
    ['#DDDDDD', 'Class \u2192 species link'],
  ],
};

function edgeLegendItems() {
  const defs = EDGE_LEGEND[NETWORK_TYPE] || [];
  const present = new Set(EDGES.map(e => String(e.color || '').toUpperCase()));
  const known = new Set(defs.map(([c]) => c.toUpperCase()));
  const items = defs.filter(([c]) => present.has(c.toUpperCase()));
  present.forEach(c => { if (c && !known.has(c)) items.push([c, `Other (${c})`]); });
  return items;
}

function legendArrow(color, label) {
  return `<div style="display:flex;align-items:center;gap:6px;margin:2px 0;"><span style="display:inline-block;width:20px;height:0;border-top:2px solid ${color};position:relative;flex-shrink:0;"></span><span style="display:inline-block;width:0;height:0;border:4px solid transparent;border-left:6px solid ${color};margin-left:-2px;"></span> <span>${label}</span></div>`;
}
function legendLine(color, label) {
  return `<div style="display:flex;align-items:center;gap:6px;margin:2px 0;"><span style="display:inline-block;width:24px;height:0;border-top:2px solid ${color};flex-shrink:0;"></span> <span>${label}</span></div>`;
}
function legendHeatmap(label, stops) {
  return `<div style="margin:4px 0;"><div style="font-size:10px;margin-bottom:1px;">${label}</div><div style="display:flex;align-items:center;gap:4px;"><span style="font-size:9px;">Down</span><span style="display:inline-block;width:60px;height:10px;background:linear-gradient(to right,${stops.join(',')});border:1px solid #333;"></span><span style="font-size:9px;">Up</span></div></div>`;
}

function buildLegend() {
  const lc = document.getElementById('legendContent');
  const head = (label) => `<div style="font-weight:bold;font-size:10px;margin-bottom:2px;">${label}</div>`;
  const sec = (label) => `<div style="margin-top:4px;border-top:1px solid #ddd;padding-top:3px;font-weight:bold;font-size:10px;">${label}</div>`;
  let html = '';
  if (NETWORK_TYPE === 'gatom') {
    html = head('Nodes')
        + legendHeatmap('log2FC', LOG2FC_RAMP)
        + sec('Edges')
        + edgeLegendItems().map(([c, l]) => legendArrow(c, l)).join('');
  } else if (NETWORK_TYPE === 'lipid_reaction') {
    html = head('Nodes')
        + legendSwatch('square', '#CCCCCC', 'Lipid class')
        + legendSwatch('circle', '#CCCCCC', 'Lipid species')
        + sec('Edges')
        + edgeLegendItems().map(([c, l]) => c.toUpperCase() === '#DDDDDD' ? legendLine(c, l) : legendArrow(c, l)).join('')
        + sec('Color scale')
        + legendHeatmap('Class log2FC', ['#6A5ACD', '#CCCCFF', '#CCCCCC', '#FFFACD', '#FFD700'])
        + legendHeatmap('Species log2FC', ['#4169E1', '#CCEEFF', '#CCCCCC', '#FFE4E1', '#FF4500']);
  } else if (NETWORK_TYPE === 'pathway') {
    html = head('Nodes')
        + legendSwatch('circle', '#DDDDDD', 'Lipid class')
        + sec('Edges (pathway score z)')
        + edgeLegendItems().map(([c, l]) => legendArrow(c, l)).join('');
  }
  lc.innerHTML = html;
}

// Legend entries matching buildLegend() on screen: header / section divider / swatch / arrow / heatmap,
// with the exact same labels the HTML legend displays.
function getLegendItems() {
  const items = [];
  if (NETWORK_TYPE === 'gatom') {
    items.push({t:'header', label:'Nodes'});
    items.push({t:'heatmap', label:'log2FC', stops: LOG2FC_RAMP});
    items.push({t:'section', label:'Edges'});
    edgeLegendItems().forEach(([color, label]) => items.push({t:'arrow', color, label}));
  } else if (NETWORK_TYPE === 'lipid_reaction') {
    items.push({t:'header', label:'Nodes'});
    items.push({t:'swatch', shape:'square', color:'#CCCCCC', label:'Lipid class'});
    items.push({t:'swatch', shape:'circle', color:'#CCCCCC', label:'Lipid species'});
    items.push({t:'section', label:'Edges'});
    edgeLegendItems().forEach(([color, label]) => items.push({t: color.toUpperCase() === '#DDDDDD' ? 'line' : 'arrow', color, label}));
    items.push({t:'section', label:'Color scale'});
    items.push({t:'heatmap', label:'Class log2FC', stops: ['#6A5ACD', '#CCCCFF', '#CCCCCC', '#FFFACD', '#FFD700']});
    items.push({t:'heatmap', label:'Species log2FC', stops: ['#4169E1', '#CCEEFF', '#CCCCCC', '#FFE4E1', '#FF4500']});
  } else if (NETWORK_TYPE === 'pathway') {
    items.push({t:'header', label:'Nodes'});
    items.push({t:'swatch', shape:'circle', color:'#DDDDDD', label:'Lipid class'});
    items.push({t:'section', label:'Edges (pathway score z)'});
    edgeLegendItems().forEach(([color, label]) => items.push({t:'arrow', color, label}));
  }
  return items;
}

function updateLegendFont() {
  const fs = document.getElementById('legendFontSize').value;
  document.getElementById('legendContent').style.fontSize = fs + 'px';
  document.getElementById('legendFontSizeVal').textContent = fs;
}

// Legend is fixed at top-right (no dragging)

// Init
buildLegend();
buildSelectionTable();
updateEdgeOpacity();
fitNetwork();
